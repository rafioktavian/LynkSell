rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; 
    }
    
    // We only expose published pages to public reads for client-side fetches (if needed)
    // Most data fetching is through Next.js SSR via Admin SDK, which bypasses these rules.
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published';
    }
  }
}
